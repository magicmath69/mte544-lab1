\@writefile{toc}{\contentsline {section}{\numberline {1}Logged errors, tuning process and trajectories}{1}{section*.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Point controller, goal 1\,m straight ahead, $k_{lp}=0.2$ (heading error below 0.6$^\circ $, so the heading gains play no part). Blue: P on the robot (17:01:24). Orange: our PID, same controller code, \textbf  {simulated, not measured}, on a robot model fitted to run 17:12:26 (\texttt  {sim\_point.py}). (a, b) $e$ and $\dot  e$ vs time, (c) $x$, $y$, $\theta $ vs time, (d) path, (e, f) $\dot  e$ vs $e$. Neither command reaches the 0.22\,m/s limit (PID peaks at 0.207\,m/s). P slows in proportion to $e_d$ and stops 9\,mm short of the goal at 0.03\,m/s after 14.4\,s; the integral keeps PID faster: within 1\,cm after 7.6\,s, still at 0.09\,m/s. After the stop command the model rolls on for its delay and lag, after the logs end: PID ends $\approx $3\,cm past the goal, P $\approx $0.5\,cm. With a goal behind the robot the distance integral winds up during the turn and the simulated PID circles the goal, so we avoided it.}}{1}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:point}{{1}{1}{Point controller, goal 1\,m straight ahead, $k_{lp}=0.2$ (heading error below 0.6$^\circ $, so the heading gains play no part). Blue: P on the robot (17:01:24). Orange: our PID, same controller code, \textbf {simulated, not measured}, on a robot model fitted to run 17:12:26 (\texttt {sim\_point.py}). (a, b) $e$ and $\dot e$ vs time, (c) $x$, $y$, $\theta $ vs time, (d) path, (e, f) $\dot e$ vs $e$. Neither command reaches the 0.22\,m/s limit (PID peaks at 0.207\,m/s). P slows in proportion to $\ed $ and stops 9\,mm short of the goal at 0.03\,m/s after 14.4\,s; the integral keeps PID faster: within 1\,cm after 7.6\,s, still at 0.09\,m/s. After the stop command the model rolls on for its delay and lag, after the logs end: PID ends $\approx $3\,cm past the goal, P $\approx $0.5\,cm. With a goal behind the robot the distance integral winds up during the turn and the simulated PID circles the goal, so we avoided it}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Tuning on the robot. (a) $e_d$ for seven values of $k_{lp}$ (P, goal 1\,m ahead). (b) Normalised heading error for three values of $k_{ap}$ (P, goal behind; the 2.5 run used $k_{lp}=0.8$, the others 0.2).}}{2}{figure.caption.3}\protected@file@percent }
\newlabel{fig:tuning}{{2}{2}{Tuning on the robot. (a) $\ed $ for seven values of $k_{lp}$ (P, goal 1\,m ahead). (b) Normalised heading error for three values of $k_{ap}$ (P, goal behind; the 2.5 run used $k_{lp}=0.8$, the others 0.2)}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Trajectories on the robot. (a) Parabola $y=x^2$, $x\in [0,1.5]$, with P (17:36:05), PI (18:01:56) and our PID (18:17:44) at the same $k_{lp}=0.2$, $k_{ap}=1.0$. (b) Sigmoid, stretched to $y=2/(1+e^{-x})-1$, $x\in [0,4]$, with our PID (18:27:45). (c) Distance from the robot to the reference curve. The P run used a 1\,cm end tolerance (PI, PID: 5\,cm); it was within 5\,cm of the end after 21.3\,s.}}{2}{figure.caption.4}\protected@file@percent }
\newlabel{fig:traj}{{3}{2}{Trajectories on the robot. (a) Parabola $y=x^2$, $x\in [0,1.5]$, with P (17:36:05), PI (18:01:56) and our PID (18:17:44) at the same $k_{lp}=0.2$, $k_{ap}=1.0$. (b) Sigmoid, stretched to $y=2/(1+e^{-x})-1$, $x\in [0,4]$, with our PID (18:27:45). (c) Distance from the robot to the reference curve. The P run used a 1\,cm end tolerance (PI, PID: 5\,cm); it was within 5\,cm of the end after 21.3\,s}{figure.caption.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}P vs PID point controller: stability analysis and discussion}{2}{section*.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Point controller, goal 1\,m straight ahead, $k_{lp}=0.2$. P: measured on the robot (run 17:01:24). \textbf  {PID: our PID, simulated, not measured} (PID point runs were skipped on the TAs' recommendation due to limited lab time): the same controller code on a robot model fitted to run 17:12:26. Rise time: distance from 90\,\% to 10\,\% of its start value. Settling: last exit from $\pm 5\,\%$. Times from the first command. Percent overshoot: peak past the goal of the linear model of the distance loop (\texttt  {expected\_pid.py}, below), which keeps controlling past the goal. The logs end inside the 1\,cm tolerance; the final position adds the model's roll after the stop command (delay + lag). The heading error stays below 0.6$^\circ $, so only the distance loop is compared.}}{3}{table.caption.6}\protected@file@percent }
\newlabel{tab:pvspid}{{1}{3}{Point controller, goal 1\,m straight ahead, $k_{lp}=0.2$. P: measured on the robot (run 17:01:24). \textbf {PID: our PID, simulated, not measured} (PID point runs were skipped on the TAs' recommendation due to limited lab time): the same controller code on a robot model fitted to run 17:12:26. Rise time: distance from 90\,\% to 10\,\% of its start value. Settling: last exit from $\pm 5\,\%$. Times from the first command. Percent overshoot: peak past the goal of the linear model of the distance loop (\texttt {expected\_pid.py}, below), which keeps controlling past the goal. The logs end inside the 1\,cm tolerance; the final position adds the model's roll after the stop command (delay + lag). The heading error stays below 0.6$^\circ $, so only the distance loop is compared}{table.caption.6}{}}
