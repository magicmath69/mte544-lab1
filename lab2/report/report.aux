\@writefile{toc}{\contentsline {section}{\numberline {1}Logged errors, tuning process and trajectories}{1}{section*.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Point controller, goal 1\,m straight ahead, $k_{lp}=0.2$ (heading error below 0.6$^\circ $, so the heading gains play no part). Blue: P on the robot (17:01:24). Orange: PID, same controller code, gains of our last robot runs ($k_{lv}=0.05$, $k_{li}=0.025$, $k_{ap}=1.0$, $k_{av}=0.2$, $k_{ai}=0.025$; 18:17:44--18:27:45), \textbf  {simulated, not measured}, on a robot model fitted to run 17:12:26 (\texttt  {sim\_point.py}). (a, b) $e$ and $\dot  e$ vs time, (c) $x$, $y$, $\theta $ vs time, (d) path, (e, f) $\dot  e$ vs $e$. Neither command reaches the 0.22\,m/s limit (PID peaks at 0.207\,m/s). P slows in proportion to $e_d$ and stops 9\,mm from the goal at 0.03\,m/s after 14.4\,s; the integral keeps PID faster: within 1\,cm after 7.6\,s, still at 0.09\,m/s, so after the stop command it rolls $\approx $4\,cm past the goal (P: $\approx $1.5\,cm; model delay + lag, after the logs end). With a goal behind the robot the distance integral winds up during the turn and the simulated PID circles the goal, so we avoided it.}}{1}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:point}{{1}{1}{Point controller, goal 1\,m straight ahead, $k_{lp}=0.2$ (heading error below 0.6$^\circ $, so the heading gains play no part). Blue: P on the robot (17:01:24). Orange: PID, same controller code, gains of our last robot runs ($k_{lv}=0.05$, $k_{li}=0.025$, $k_{ap}=1.0$, $k_{av}=0.2$, $k_{ai}=0.025$; 18:17:44--18:27:45), \textbf {simulated, not measured}, on a robot model fitted to run 17:12:26 (\texttt {sim\_point.py}). (a, b) $e$ and $\dot e$ vs time, (c) $x$, $y$, $\theta $ vs time, (d) path, (e, f) $\dot e$ vs $e$. Neither command reaches the 0.22\,m/s limit (PID peaks at 0.207\,m/s). P slows in proportion to $\ed $ and stops 9\,mm from the goal at 0.03\,m/s after 14.4\,s; the integral keeps PID faster: within 1\,cm after 7.6\,s, still at 0.09\,m/s, so after the stop command it rolls $\approx $4\,cm past the goal (P: $\approx $1.5\,cm; model delay + lag, after the logs end). With a goal behind the robot the distance integral winds up during the turn and the simulated PID circles the goal, so we avoided it}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Tuning on the robot. (a) $e_d$ for seven values of $k_{lp}$ (P, goal 1\,m ahead). (b) Normalised heading error for three values of $k_{ap}$ (P, goal behind; the 2.5 run used $k_{lp}=0.8$, the others 0.2). (c) Distance from the parabola for six PID gain sets ($k_{lp}=0.2$, $k_{li}=k_{ai}=0.025$).}}{2}{figure.caption.3}\protected@file@percent }
\newlabel{fig:tuning}{{2}{2}{Tuning on the robot. (a) $\ed $ for seven values of $k_{lp}$ (P, goal 1\,m ahead). (b) Normalised heading error for three values of $k_{ap}$ (P, goal behind; the 2.5 run used $k_{lp}=0.8$, the others 0.2). (c) Distance from the parabola for six PID gain sets ($k_{lp}=0.2$, $k_{li}=k_{ai}=0.025$)}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}P vs PID point controller: stability analysis and discussion}{2}{section*.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Trajectories on the robot. (a) Parabola $y=x^2$, $x\in [0,1.5]$, with P (17:36:05), PI (18:01:56) and our chosen PID (18:08:53) at the same $k_{lp}=0.2$, $k_{ap}=1.0$. (b) Sigmoid $y=2/(1+e^{-2x})-1$, $x\in [0,2.5]$, with PID at $k_{av}=0.2$ (18:18:30), and the stretched sigmoid $y=2/(1+e^{-x})-1$, $x\in [0,4]$, with the same gains (18:27:45). (c) Distance from the robot to the reference curve, line styles as in (a, b). The P run used a 1\,cm end tolerance (PI, PID: 5\,cm); it was within 5\,cm of the end after 21.3\,s.}}{3}{figure.caption.4}\protected@file@percent }
\newlabel{fig:traj}{{3}{3}{Trajectories on the robot. (a) Parabola $y=x^2$, $x\in [0,1.5]$, with P (17:36:05), PI (18:01:56) and our chosen PID (18:08:53) at the same $k_{lp}=0.2$, $k_{ap}=1.0$. (b) Sigmoid $y=2/(1+e^{-2x})-1$, $x\in [0,2.5]$, with PID at $k_{av}=0.2$ (18:18:30), and the stretched sigmoid $y=2/(1+e^{-x})-1$, $x\in [0,4]$, with the same gains (18:27:45). (c) Distance from the robot to the reference curve, line styles as in (a, b). The P run used a 1\,cm end tolerance (PI, PID: 5\,cm); it was within 5\,cm of the end after 21.3\,s}{figure.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Point controller, goal 1\,m behind the robot, $k_{lp}=0.2$, $k_{ap}=0.5$. P: measured on the robot (run 17:12:26). \textbf  {PID: expected, not measured} (PID point runs were skipped on the TAs' recommendation due to limited lab time), with our default $k_{lv}=0.05$, $k_{li}=0.1$, $k_{av}=0.25$, $k_{ai}=0.03$, from the linear analysis of each loop below (lag $\tau =0.2$\,s). Rise time: error from 90\,\% to 10\,\%. Settling: last exit from $\pm 5\,\%$. Heading metrics leave out the last 15\,cm, where the bearing is ill-defined.}}{3}{table.caption.6}\protected@file@percent }
\newlabel{tab:pvspid}{{1}{3}{Point controller, goal 1\,m behind the robot, $k_{lp}=0.2$, $k_{ap}=0.5$. P: measured on the robot (run 17:12:26). \textbf {PID: expected, not measured} (PID point runs were skipped on the TAs' recommendation due to limited lab time), with our default $k_{lv}=0.05$, $k_{li}=0.1$, $k_{av}=0.25$, $k_{ai}=0.03$, from the linear analysis of each loop below (lag $\tau =0.2$\,s). Rise time: error from 90\,\% to 10\,\%. Settling: last exit from $\pm 5\,\%$. Heading metrics leave out the last 15\,cm, where the bearing is ill-defined}{table.caption.6}{}}
